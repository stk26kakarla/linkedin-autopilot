# Copy to .env for local testing (never commit .env). In GitHub, set these as
# repository Secrets instead (Settings > Secrets and variables > Actions).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Prefer refresh token; fall back to access token if none is issued.
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN=

# Optional phone preview
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional non-secret overrides (set as repo Variables, not Secrets).
# These are the built-in defaults; set a variable only to override one.
# CLAUDE_MODEL=claude-sonnet-5
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_ASPECT_RATIO=1:1
# GEMINI_IMAGE_SIZE=1K
# LINKEDIN_API_VERSION=202608
